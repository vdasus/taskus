<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>taskus</AssemblyName>
    <RootNamespace>Taskus</RootNamespace>
    <Version>0.10.0</Version>
    <Authors>vdasus</Authors>
    <Copyright>Copyright (C) 2026 vdasus</Copyright>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Taskus.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Kept next to taskus.exe, outside the single file, so it can be edited. -->
    <None Update="taskus.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Taskus.Core\Taskus.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Optionus" />
    <PackageReference Include="Serilog.Settings.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

</Project>
