# Copy to secrets.yaml next to taskus.exe and fill in.
# The file holds passwords in plain text: allow only the accounts that run Taskus to read it.
# SSL Mode=VerifyFull: encrypted, and the server certificate must be trusted by Windows and match the host name.
pg_main: Host=db.example.com;Database=main;Username=taskus;Password=change-me;SSL Mode=VerifyFull
smtp_main:
  server: smtp.example.com
  port: 587
  user: taskus
  password: change-me
  from: noreply@example.com
api_token: change-me
